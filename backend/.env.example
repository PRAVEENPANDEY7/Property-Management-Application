# ==============================================================================
# Property Management Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# NEVER commit .env with real production secrets to version control.

# Application Server
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/propertymanagement
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password

# JWT Authentication
# Minimum 256 bits (32 bytes) secret for HMAC-SHA256 signature
JWT_SECRET=your_secure_random_base64_or_hex_encoded_secret_key_at_least_32_bytes_long
JWT_EXPIRATION_MS=86400000

# Persistent Server-side Image Storage
STORAGE_LOCATION=uploads/properties

# CORS Allowed Origins (comma-separated list for Vite dev and production domains)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Initial Bootstrap Administrator Account
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=ChangeMeOnFirstLogin123!
