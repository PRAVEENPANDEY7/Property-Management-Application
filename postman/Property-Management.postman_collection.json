                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/properties?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "properties"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Create Property with Images",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Highland Luxury Villa", "type": "text" },
                { "key": "description", "value": "Magnificent luxury estate featuring infinity pool and private grounds.", "type": "text" },
                { "key": "price", "value": "1450000.00", "type": "text" },
                { "key": "location", "value": "500 Highland Peak Way", "type": "text" },
                { "key": "city", "value": "Austin", "type": "text" },
                { "key": "images", "description": "Select JPEG or PNG files", "type": "file", "src": [] }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/properties",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "properties"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Property created and id saved to testPropertyId\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.id).to.be.a('number');",
                  "    pm.environment.set(\"testPropertyId\", json.data.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update Property",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Highland Luxury Villa (Renovated)", "type": "text" },
                { "key": "description", "value": "Recently updated luxury estate with upgraded modern amenities.", "type": "text" },
                { "key": "price", "value": "1550000.00", "type": "text" },
                { "key": "location", "value": "500 Highland Peak Way", "type": "text" },
                { "key": "city", "value": "Austin", "type": "text" },
                { "key": "newImages", "type": "file", "src": [] }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/properties/{{testPropertyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "properties", "{{testPropertyId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Updated name and price verified\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.name).to.include(\"Renovated\");",
                  "    pm.expect(json.data.price).to.eql(1550000.00);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Submit Property Inquiry",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Customer\",\n  \"email\": \"alice@example.com\",\n  \"phone\": \"+1 (555) 987-6543\",\n  \"message\": \"I would like to schedule an estate walkthrough.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/properties/{{testPropertyId}}/inquiries",
              "host": ["{{baseUrl}}"],
              "path": ["api", "properties", "{{testPropertyId}}", "inquiries"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Inquiry created with NEW status and ID saved\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.status).to.eql(\"NEW\");",
                  "    pm.expect(json.data.email).to.eql(\"alice@example.com\");",
                  "    pm.environment.set(\"inquiryId\", json.data.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Admin Inquiries",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/inquiries?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "inquiries"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Inquiries page returned with content\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.content).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update Inquiry Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/inquiries/{{inquiryId}}/status?status=CONTACTED",
              "host": ["{{baseUrl}}"],
